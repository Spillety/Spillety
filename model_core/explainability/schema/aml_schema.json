{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://k-brain.org/schemas/aml-explanation.json", "title": "AMLExplanation", "type": "object", "required": ["explanation_id", "causal_paths", "counterfactuals", "jurisdiction", "confidence_score", "timestamp"], "properties": {"explanation_id": {"type": "string", "format": "uuid"}, "causal_paths": {"type": "array", "items": {"type": "object", "required": ["path", "effect"], "properties": {"path": {"type": "array", "items": {"type": "string"}}, "effect": {"type": "number"}}}}, "counterfactuals": {"type": "array", "items": {"type": "object", "required": ["distance", "fidelity"], "properties": {"distance": {"type": "number", "minimum": 0}, "fidelity": {"type": "number", "minimum": 0, "maximum": 1}}}}, "jurisdiction": {"type": "string"}, "confidence_score": {"type": "number", "minimum": 0, "maximum": 1}, "risk_score": {"type": "number", "minimum": 0, "maximum": 100}, "regulation_ref": {"type": "string"}, "timestamp": {"type": "string", "format": "date-time"}}, "additionalProperties": false}
