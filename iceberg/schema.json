{
  "$id": "https://k-brain.org/schemas/iceberg-alert-record.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IcebergAlertRecord",
  "description": "Partitioned alert archive record. Partition keys: event_date derived from alert timestamp.",
  "type": "object",
  "required": ["alert_id", "event_date", "alert"],
  "properties": {
    "alert_id": {"type": "string", "format": "uuid"},
    "event_date": {"type": "string", "format": "date"},
    "alert": {"type": "object"}
  }
}
